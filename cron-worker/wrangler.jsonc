{
  "name": "kidsnote-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "triggers": {
    "crons": [
      // KST 19:30 — 세션 갱신. 미러 30분 전이라 밤새 죽은 쿠키가 그날
      //              미러 전에 갈린다.
      "30 10 * * *",
      // KST 20:00 — 미러. 하루 1회.
      "0 11 * * *",
      // KST 22:00 — 신선도 확인. 미러와 배포가 끝난 뒤라야 오늘 결과를
      //              본다. 미러 앞에 두면 어제 export 를 보고 오탐한다.
      "0 13 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
